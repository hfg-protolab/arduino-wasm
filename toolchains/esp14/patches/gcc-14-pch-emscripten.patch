PCH for an Emscripten (wasm32) host (GCC 14; replaces gcc-8-pch-emscripten.patch of toolchains/esp).

wasm32 has no mmap at a chosen address; the Linux hooks fail ("PCH allocation failure").
GCC >= 12 relocates a PCH loaded elsewhere, so allocate a 64 KiB-aligned block and let
gt_pch_restore read the file into it and relocate. No arena, no fixed address needed.

--- a/gcc/config/host-linux.cc
+++ b/gcc/config/host-linux.cc
@@ -23,7 +23,51 @@
 #include "hosthooks.h"
 #include "hosthooks-def.h"
 
+#ifdef __EMSCRIPTEN__
+/* PCH for an Emscripten (wasm32) host.  wasm linear memory has no mmap at a chosen address
+   (Emscripten's mmap ignores the hint), so the Linux hooks below fail ("PCH allocation
+   failure").  Since GCC 12 a PCH can be loaded at another address than it was written for
+   (gt_pch_restore relocates the pointers), so: allocate a block, let ggc read the file into it
+   and relocate.  */
 
+static void *
+em_gt_pch_get_address (size_t size, int fd ATTRIBUTE_UNUSED)
+{
+  /* Only the address matters (the PCH is written relative to it): reserve, note, release.  */
+  void *raw = xmalloc (size + 65536);
+  void *base = (void *) (((uintptr_t) raw + 65535) & ~(uintptr_t) 65535);
+  free (raw);
+  return base;
+}
+
+/* 0: memory is at BASE (possibly moved), read the file into it; -1: cannot.  */
+static int
+em_gt_pch_use_address (void *&base, size_t size, int fd ATTRIBUTE_UNUSED,
+		       size_t offset ATTRIBUTE_UNUSED)
+{
+  if (size == 0)
+    return -1;
+  /* system.h poisons malloc; xmalloc aborts when out of memory.  */
+  void *raw = xmalloc (size + 65536);
+  base = (void *) (((uintptr_t) raw + 65535) & ~(uintptr_t) 65535);
+  return 0;
+}
+
+static size_t
+em_gt_pch_alloc_granularity (void)
+{
+  return 65536;
+}
+
+#undef HOST_HOOKS_GT_PCH_GET_ADDRESS
+#define HOST_HOOKS_GT_PCH_GET_ADDRESS em_gt_pch_get_address
+#undef HOST_HOOKS_GT_PCH_USE_ADDRESS
+#define HOST_HOOKS_GT_PCH_USE_ADDRESS em_gt_pch_use_address
+#undef HOST_HOOKS_GT_PCH_ALLOC_GRANULARITY
+#define HOST_HOOKS_GT_PCH_ALLOC_GRANULARITY em_gt_pch_alloc_granularity
+#else /* !__EMSCRIPTEN__ */
+
+
 /* Linux has a feature called exec-shield-randomize that perturbs the
    address of non-fixed mapped segments by a (relatively) small amount.
    The feature is intended to make it harder to attack the system with
@@ -229,4 +273,6 @@
 }
 
 
+#endif /* !__EMSCRIPTEN__ */
+
 const struct host_hooks host_hooks = HOST_HOOKS_INITIALIZER;
